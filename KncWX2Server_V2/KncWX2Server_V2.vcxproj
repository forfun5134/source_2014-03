    <ClInclude Include="src\security\SecurityAssociation.h" />
    <ClInclude Include="third_party\miniz\miniz.h" />
    <ClInclude Include="third_party\miniz\miniz_common.h" />
    <ClInclude Include="third_party\miniz\miniz_export.h" />
    <ClInclude Include="third_party\miniz\miniz_tdef.h" />
    <ClInclude Include="third_party\miniz\miniz_tinfl.h" />
    <ClInclude Include="third_party\sqlite\sqlite3.h" />
    <ClInclude Include="third_party\sqlite\sqlite3ext.h" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <ImportGroup Label="ExtensionTargets">
