    <ClCompile Include="src\server\UnitSelectArbiter.cpp" />
    <ClCompile Include="src\server\UnitListProtocol.cpp" />
    <ClCompile Include="src\server\CreateUnitProtocol.cpp" />
    <ClCompile Include="src\server\UnitData.cpp" />
    <ClCompile Include="src\core\SerBuffer.cpp" />
    <ClCompile Include="src\core\UidType.cpp" />
    <ClCompile Include="src\core\Sha256.cpp" />
    <ClCompile Include="src\security\Des.cpp" />
    <ClCompile Include="src\security\Md5.cpp" />
    <ClCompile Include="src\security\SADatabase.cpp" />
    <ClCompile Include="src\security\SecureBuffer.cpp" />
    <ClCompile Include="src\security\SecurityAssociation.cpp" />
    <!-- 內建 SQLite 合體版（C 編譯） -->
    <ClCompile Include="third_party\sqlite\sqlite3.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAs>CompileAsC</CompileAs>
      <PreprocessorDefinitions>SQLITE_THREADSAFE=2;SQLITE_ENABLE_FTS5;SQLITE_ENABLE_JSON1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <!-- miniz（C 編譯）：zlib 格式相容，取代原 zlib 依賴（kbuff 壓縮格式相容） -->
    <ClCompile Include="third_party\miniz\miniz.c">
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
    <ClCompile Include="third_party\miniz\miniz_tdef.c">
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
    <ClCompile Include="third_party\miniz\miniz_tinfl.c">
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="src\core\ByteOrder.h" />
    <ClInclude Include="src\core\Event.h" />
